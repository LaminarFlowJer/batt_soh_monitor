VAL_ 256 BMS_State 7 "Shutdown" 6 "Fault" 5 "Charge" 4 "Drive" 3 "Ready" 2 "Precharge" 1 "Standby" 0 "Init" ;
VAL_ 260 BMS_MainPosContactorState 3 "Error" 2 "Welded" 1 "Closed" 0 "Open" ;
VAL_ 260 BMS_MainNegContactorState 3 "Error" 2 "Welded" 1 "Closed" 0 "Open" ;
VAL_ 260 BMS_PrechargeContactorState 3 "Error" 2 "Welded" 1 "Closed" 0 "Open" ;
VAL_ 260 BMS_HVIL_Status 1 "Closed" 0 "Open" ;
VAL_ 260 BMS_ReadyToClose 1 "Ready" 0 "NotReady" ;
VAL_ 260 BMS_PrechargeStatus 4 "Failed" 3 "Timeout" 2 "Complete" 1 "InProgress" 0 "Idle" ;
VAL_ 260 BMS_IsolationStatus 3 "NotAvailable" 2 "Fault" 1 "Warning" 0 "OK" ;
VAL_ 261 BMS_FaultLevel 5 "Emergency" 4 "DisconnectRequested" 3 "Derate" 2 "Warning" 1 "Info" 0 "None" ;
VAL_ 261 BMS_ThermalRunawayWarning 1 "Detected" 0 "None" ;
VAL_ 261 BMS_OverVoltageFault 1 "Fault" 0 "OK" ;
