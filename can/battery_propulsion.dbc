VAL_ 513 PCU_RegenActive 1 "Active" 0 "Inactive" ;
VAL_ 513 PCU_InverterReady 1 "Ready" 0 "NotReady" ;
VAL_ 514 PCU_FaultLevel 5 "Emergency" 4 "DisconnectRequested" 3 "Derate" 2 "Warning" 1 "Info" 0 "None" ;
